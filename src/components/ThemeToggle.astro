---
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Switch color theme"
  class="inline-flex items-center gap-2 rounded-full border border-sb-border px-3 py-1.5 font-mono text-xs text-sb-primary transition-colors hover:border-sb-primary"
>
  <svg id="icon-sun" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <svg id="icon-moon" class="hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
  <span id="theme-label">dark mode</span>
</button>

<script is:inline>
  (function () {
    const root = document.documentElement;
    const button = document.getElementById("theme-toggle");
    const label = document.getElementById("theme-label");
    const sun = document.getElementById("icon-sun");
    const moon = document.getElementById("icon-moon");

    function syncUI() {
      const isDark = root.classList.contains("dark");
      label.textContent = isDark ? "light mode" : "dark mode";
      sun.classList.toggle("hidden", isDark);
      moon.classList.toggle("hidden", !isDark);
    }

    button.addEventListener("click", function () {
      const isDark = root.classList.toggle("dark");
      localStorage.setItem("sb-theme", isDark ? "dark" : "light");
      syncUI();
    });

    syncUI();
  })();
</script>
