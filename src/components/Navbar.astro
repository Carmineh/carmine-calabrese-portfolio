---
import { Image } from "astro:assets";
import logo from "@assets/sb-template-logo.webp";
---

<header
  class="sticky top-0 z-30 py-5 border-b border-sb-border backdrop-blur-md bg-sb-background/85"
>
  <div class="max-w-[1180px] mx-auto px-7">
    <nav class="flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <Image
          src={logo}
          alt="sb-template-astro"
          height={72}
          class="h-9 w-auto"
        />
        <span class="font-bold text-[15px]">sb-template-astro</span>
      </div>
      <div class="hidden min-[1000px]:flex gap-6">
        <a
          href="#contenuto"
          class="text-[13.5px] font-semibold text-sb-muted-foreground hover:text-sb-foreground"
          >Cosa contiene</a
        >
        <a
          href="#iniziare"
          class="text-[13.5px] font-semibold text-sb-muted-foreground hover:text-sb-foreground"
          >Come iniziare</a
        >
        <a
          href="#requisiti"
          class="text-[13.5px] font-semibold text-sb-muted-foreground hover:text-sb-foreground"
          >Requisiti</a
        >
        <a
          href="#struttura"
          class="text-[13.5px] font-semibold text-sb-muted-foreground hover:text-sb-foreground"
          >Struttura</a
        >
      </div>
      <div class="flex items-center gap-3.5">
        <button
          id="theme-toggle"
          type="button"
          aria-label="Cambia tema chiaro/scuro"
          class="border-[1.5px] border-sb-border rounded-full px-3.5 py-1.5 text-[12.5px] text-sb-muted-foreground bg-transparent"
          >☾ / ☀</button
        >
        <a
          href="https://github.com/stefanBid/sb-template-astro"
          target="_blank"
          rel="noopener"
          class="border-[1.5px] border-sb-foreground rounded-full px-4.5 py-2 text-[13.5px] font-bold"
          >GitHub</a
        >
      </div>
    </nav>
  </div>
</header>

<script>
  // Placeholder: toggle manuale del tema. In produzione, sostituisci con
  // una gestione persistita (localStorage / prefers-color-scheme) e
  // idealmente evita il flash-of-wrong-theme leggendo la preferenza
  // in un piccolo script inline nell'head, prima del render del body.
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    document.documentElement.classList.toggle("dark");
  });
</script>
