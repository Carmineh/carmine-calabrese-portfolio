---
const steps = [
  {
    step: "01",
    title: "use this template",
    description: 'click the green "Use this template" button at the top of the repo, then "Create a new repository".',
  },
  {
    step: "02",
    title: "name your repo",
    description: "GitHub creates a brand new repository with this codebase, full history-free — no fork relationship, no PRs back here.",
  },
  {
    step: "03",
    title: "clone & ship",
    description: "clone your new repo, pnpm install, pnpm dev — same design system, your content.",
  },
];
---

<section class="mx-auto max-w-2xl px-6 pb-20">
  <div class="rounded-lg border border-sb-border bg-sb-card px-6 py-8">
    <span class="inline-block rounded-full border border-sb-primary/40 px-3 py-1 font-mono text-[11px] text-sb-primary">
      github template repository
    </span>

    <h2 class="mt-4 text-xl font-medium text-sb-foreground">
      This is a template, not just a repo.
    </h2>

    <p class="mt-3 text-sm text-sb-muted-foreground">
      A <a
        href="https://docs.github.com/en/repositories/creating-and-managing-repositories/creating-a-template-repository"
        class="text-sb-primary underline underline-offset-2"
        target="_blank"
        rel="noopener noreferrer"
      >GitHub template repository</a> lets anyone spin up a new, independent repo pre-loaded with this
      code and structure — no manual copy-pasting, no shared git history with the original.
    </p>

    <ol class="mt-6 space-y-4">
      {
        steps.map((item) => (
          <li class="flex gap-4">
            <span class="font-mono text-xs text-sb-primary">{item.step}</span>
            <div>
              <p class="font-mono text-xs font-medium text-sb-foreground">{item.title}</p>
              <p class="mt-1 text-xs text-sb-muted-foreground">{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <a
      href="https://docs.github.com/en/repositories/creating-and-managing-repositories/creating-a-template-repository"
      class="mt-6 inline-block font-mono text-xs text-sb-muted-foreground hover:text-sb-foreground"
      target="_blank"
      rel="noopener noreferrer"
    >
      read the full GitHub docs →
    </a>
  </div>
</section>
