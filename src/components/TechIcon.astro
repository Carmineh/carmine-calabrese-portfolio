---
/**
 * Renders a technology icon.
 * - Brand logos come from simple-icons (official SVG paths + brand colour).
 * - Concepts without a logo (e.g. "mutation testing") use outline icons in the Lucide style.
 * Use the keys of `brands` / `outline` below as `icon` in src/data/skills.ts.
 */
import {
  siOpenjdk,
  siPython,
  siC,
  siDotnet,
  siJavascript,
  siTypescript,
  siSolidity,
  siReact,
  siHtml5,
  siCss,
  siPostgresql,
  siMysql,
  siMongodb,
  siGit,
  siGithub,
  siGithubactions,
  siDocker,
  siLinux,
  siKalilinux,
  siUnity,
  siCurseforge,
  siEthereum,
  siJunit5,
  siPytest,
  siOwasp,
  siWireshark,
  siBurpsuite,
  siGnubash,
  siPostman,
  siAstro,
  siTailwindcss,
  siJira,
  siItchdotio,
} from 'simple-icons';

interface Props {
  name: string;
  class?: string;
  /** Use the brand colour instead of the current text colour (off by default: the site is monochrome) */
  brandColor?: boolean;
}

const { name, class: className = 'w-5 h-5', brandColor = false } = Astro.props;
const key = name.toLowerCase().trim();

const brands: Record<string, { path: string; hex: string; title: string }> = {
  java: siOpenjdk,
  python: siPython,
  c: siC,
  csharp: siDotnet,
  javascript: siJavascript,
  typescript: siTypescript,
  solidity: siSolidity,
  react: siReact,
  html: siHtml5,
  css: siCss,
  postgresql: siPostgresql,
  mysql: siMysql,
  mongodb: siMongodb,
  git: siGit,
  github: siGithub,
  githubactions: siGithubactions,
  docker: siDocker,
  linux: siLinux,
  kali: siKalilinux,
  unity: siUnity,
  minecraft: siCurseforge,
  ethereum: siEthereum,
  junit: siJunit5,
  pytest: siPytest,
  owasp: siOwasp,
  wireshark: siWireshark,
  burpsuite: siBurpsuite,
  bash: siGnubash,
  postman: siPostman,
  astro: siAstro,
  tailwind: siTailwindcss,
  jira: siJira,
  itchio: siItchdotio,
};

// Outline icons (24x24, stroke based)
const outline: Record<string, string> = {
  shield: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z M9 12l2 2 4-4',
  radar: 'M19.07 4.93A10 10 0 0 0 6.99 3.34 M4 6h.01 M2.29 9.62A10 10 0 1 0 21.31 8.35 M16.24 7.76A6 6 0 1 0 8.23 16.67 M12 18h.01 M17.99 11.66A6 6 0 0 1 15.77 16.67 M12 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M13.41 10.59l5.66-5.66',
  terminal: 'M4 17l6-6-6-6 M12 19h8',
  bug: 'M8 2l1.88 1.88 M14.12 3.88L16 2 M9 7.13v-1a3.003 3.003 0 1 1 6 0v1 M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6 M12 20v-9 M6.53 9C4.6 8.8 3 7.1 3 5 M6 13H2 M3 21c0-2.1 1.7-3.9 3.8-4 M20.97 5c0 2.1-1.6 3.8-3.5 4 M22 13h-4 M17.2 17c2.1.1 3.8 1.9 3.8 4',
  flask: 'M10 2v7.31 M14 9.3V1.99 M8.5 2h7 M14 9.3a6.5 6.5 0 1 1-4 0 M5.52 16h12.96',
  mutation: 'M2 15c6.667-6 13.333 0 20-6 M9 22c1.798-1.998 2.518-3.995 2.807-5.993 M15 2c-1.798 1.998-2.518 3.995-2.807 5.993 M17 6l-2.5-2.5 M14 8l-1-1 M7 18l2.5 2.5 M3.5 14.5l.5.5 M20 9l.5.5 M6.5 12.5l1 1 M16.5 10.5l1 1 M10 16l1.5 1.5',
  layers: 'M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12 M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17',
  wrench: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
  users: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0-8 0 M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75',
  sprint: 'M21 12a9 9 0 1 1-6.219-8.56 M21 3v6h-6',
  key: 'M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z M16.5 7.5m-.5 0a.5 .5 0 1 0 1 0a.5 .5 0 1 0-1 0',
  blocks: 'M10 22V7a1 1 0 0 0-1-1H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5a1 1 0 0 0-1-1H2 M14 2h6a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z',
  plug: 'M12 22v-5 M9 8V2 M15 8V2 M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8z',
  database: 'M12 5m-9 0a9 3 0 1 0 18 0a9 3 0 1 0-18 0 M3 5v14a9 3 0 0 0 18 0V5 M3 12a9 3 0 0 0 18 0',
  gamepad: 'M6 11h4 M8 9v4 M15 12h.01 M18 10h.01 M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z',
  code: 'M16 18l6-6-6-6 M8 6l-6 6 6 6',
  search: 'M11 11m-8 0a8 8 0 1 0 16 0a8 8 0 1 0-16 0 M21 21l-4.3-4.3',
  linkedin: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z M2 9h4v12H2z M4 4m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0',
  mail: 'M22 7l-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7 M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z',
  binary: 'M6 20h4 M14 10h4 M6 14h2v6 M14 4h2v6 M6 4m0 2a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h0a2 2 0 0 1-2-2z M14 14m0 2a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h0a2 2 0 0 1-2-2z',
};

const brand = brands[key];
// Some brand colours (black/very dark) are invisible on a dark background: lighten them.
const isTooDark = (hex: string) => {
  const n = parseInt(hex, 16);
  const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  return 0.2126 * r + 0.7152 * g + 0.0722 * b < 70;
};
const color = brand && brandColor ? (isTooDark(brand.hex) ? '#E2E8F0' : `#${brand.hex}`) : 'currentColor';
---

{
  brand ? (
    <svg class={className} viewBox="0 0 24 24" fill={color} role="img" aria-label={brand.title}>
      <path d={brand.path} />
    </svg>
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d={outline[key] ?? outline.code} />
    </svg>
  )
}
