---
import Layout from "@layouts/Layout.astro";
// Components
import SBNavbar from "@components/Navbar.astro";
---

<Layout title="sb-template-astro — Lascia le configurazioni a noi">
  <!-- COMPONENT: SiteHeader -->
  <SBNavbar />
  <!-- COMPONENT: Hero -->
  <section class="pt-24 px-0">
    <div class="max-w-[1180px] mx-auto px-7">
      <div
        class="flex items-center gap-2.5 sb-eyebrow text-sb-primary mb-6"
      >
        <span class="w-[7px] h-[7px] rounded-full bg-sb-primary"></span>
        <span>astro 7 · tailwind v4 · typescript strict</span>
      </div>

      <h1 class="max-w-[17ch]">
        Lascia le configurazioni<br />a <span class="text-sb-primary">noi.</span
        >
      </h1>

      <div
        class="grid grid-cols-1 min-[960px]:grid-cols-2 gap-12 items-end mt-9"
      >
        <div>
          <p
            class="text-[17.5px] max-w-[42ch] mb-7"
          >
            Parti da una base solida e già controllata, e dedica il tuo tempo a
            quello che conta davvero: le feature del tuo progetto.
          </p>
          <div class="flex gap-3.5 flex-wrap">
            <a
              href="#iniziare"
              class="btn-gradient inline-block text-[#FEF1F9] px-6 py-3.5 rounded-full font-extrabold text-[14.5px]"
              >Inizia ora</a
            >
            <a
              href="#contenuto"
              class="inline-block border-[1.5px] border-sb-foreground px-6 py-3.5 rounded-full font-bold text-[14.5px]"
              >Cosa contiene ↓</a
            >
          </div>
        </div>

        <!-- COMPONENT: TerminalWindow (variant: hero install) -->
        <div class="terminal">
          <div class="term-bar">
            <span class="term-dot"></span><span class="term-dot"></span><span
              class="term-dot"></span>
            <span class="term-title">zsh — my-project</span>
          </div>
          <div class="term-body">
            <div>
              <span class="prompt">$</span>
              <span class="cmd"
                >pnpm create astro@latest -- --template sb-template-astro</span
              >
            </div>
            <div>
              <span class="out">✔ Linting e design system configurati</span>
            </div>
            <div>
              <span class="out">✔ TypeScript strict, i18n pronti</span>
            </div>
            <div>&nbsp;</div>
            <div>
              <span class="prompt">$</span>
              <span class="cmd">pnpm dev</span>
            </div>
            <div>
              <span class="ok">✔ Server pronto su http://localhost:4321</span
              ><span class="cursor"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPONENT: StackStrip -->
  <div class="py-15 pt-16 pb-10">
    <div class="max-w-[1180px] mx-auto px-7">
      <div
        class="flex justify-center gap-10 flex-wrap text-[12.5px] font-bold text-sb-muted-foreground border-t border-b border-sb-border py-5"
      >
        <span>ASTRO 7</span><span>TAILWIND CSS V4</span><span
          >TYPESCRIPT STRICT</span
        ><span>PNPM</span><span>I18N READY</span>
      </div>
    </div>
  </div>

  <!-- COMPONENT: WhatsIncluded (id="contenuto") -->
  <section id="contenuto" class="py-24">
    <div class="max-w-[1180px] mx-auto px-7">
      <div
        class="grid grid-cols-1 min-[900px]:grid-cols-[0.55fr_1fr] gap-12 items-end mb-16"
      >
        <h2 class="sb-h2-lg">
          Cosa contiene<br />il progetto
        </h2>
        <p class="text-[16px]">
          Quattro problemi che normalmente affronti da zero ad ogni nuovo
          progetto — qui sono già risolti, documentati e pronti da adattare.
        </p>
      </div>

      <div
        class="grid grid-cols-2 min-[900px]:grid-cols-4 border-t-2 border-sb-foreground"
      >
        <div class="p-7 border-r border-b border-sb-border">
          <span
            class="block sb-label-mono-sm text-sb-primary mb-3"
            >01 · linting</span
          >
          <h3 class="mb-2.5">
            Linting già configurato
          </h3>
          <p class="text-[13.8px]">
            Per un'esperienza di sviluppo fluida, con file indentati come si
            deve e chiari — soprattutto se sul progetto lavora un team.
          </p>
        </div>
        <div
          class="p-7 border-r border-b border-sb-border max-[900px]:border-r-0"
        >
          <span
            class="block sb-label-mono-sm text-sb-primary mb-3"
            >02 · i18n</span
          >
          <h3 class="mb-2.5">i18n pronto all'uso</h3>
          <p class="text-[13.8px]">
            Una configurazione già presente, utile se il progetto prevede di
            essere distribuito in più lingue.
          </p>
        </div>
        <div class="p-7 border-r border-b border-sb-border">
          <span
            class="block sb-label-mono-sm text-sb-primary mb-3"
            >03 · design system</span
          >
          <h3 class="mb-2.5">
            Tailwind minimale, prefisso <code
              class="bg-sb-secondary px-1.5 py-0.5 rounded text-[0.9em]"
              >sb-</code
            >
          </h3>
          <p class="text-[13.8px]">
            Una configurazione Tailwind essenziale con classi utility marcate <code
              class="bg-sb-secondary px-1.5 py-0.5 rounded text-[0.9em]"
              >sb-</code
            >, modificabile nei file CSS dentro <code
              class="bg-sb-secondary px-1.5 py-0.5 rounded text-[0.9em]"
              >styles</code
            >.
          </p>
        </div>
        <div class="p-7 border-b border-sb-border featured-card text-[#FEF1F9]">
          <span
            class="block sb-label-mono-sm mb-3"
            style="color:#F9C3E6;">04 · componenti</span
          >
          <h3 class="mb-2.5">
            Un set di componenti
          </h3>
          <p
            class="text-[13.8px] leading-relaxed"
            style="color:rgba(254,241,249,.82);"
          >
            Pensato per costruire pagine complete, che puoi comunque integrare o
            estendere per esigenze particolari.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPONENT: ResponsiveShowcase -->
  <section class="py-8 pb-24 text-center">
    <div class="max-w-[1180px] mx-auto px-7">
      <blockquote class="max-w-[20ch] mx-auto">
        Un solo layout.<br />Ogni <span class="text-sb-primary"
          >dispositivo.</span
        >
      </blockquote>
      <p
        class="mt-5 mx-auto max-w-[46ch] text-[16px]"
      >
        Il progetto è responsivo e si adatta a finestre e dispositivi diversi,
        per avere un sito leggibile e usabile dal mobile al desktop.
      </p>

      <!-- COMPONENT: DeviceMockup x3 -->
      <div class="devices-row">
        <div class="device desktop">
          <div class="device-shell">
            <div class="browser-bar">
              <span class="traffic"></span><span class="traffic"></span><span
                class="traffic"></span>
              <div class="addr-pill"></div>
            </div>
            <div class="screen">
              <div class="mini-scope">
                <div class="mini-nav-row">
                  <div class="mini-logo"></div>
                  <div class="mini-nav-links">
                    <div class="mini-line" style="width:22px;"></div>
                    <div class="mini-line" style="width:22px;"></div>
                    <div class="mini-line" style="width:22px;"></div>
                  </div>
                  <div class="mini-btn" style="width:42px;"></div>
                </div>
                <div class="mini-headline" style="width:82%;"></div>
                <div class="mini-headline" style="width:55%;"></div>
                <div class="mini-sub"></div>
                <div class="mini-btn" style="width:68px; margin-bottom:16px;">
                </div>
                <div class="mini-grid">
                  <div class="mini-card"></div><div class="mini-card"></div><div
                    class="mini-card"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="stand"></div>
          <div class="base"></div>
          <div class="device-label">Desktop</div>
        </div>

        <div class="device tablet">
          <div class="device-shell">
            <div class="screen">
              <div class="mini-scope">
                <div class="mini-nav-row">
                  <div class="mini-logo"></div>
                  <div class="mini-line" style="width:24px;"></div>
                </div>
                <div class="mini-headline" style="width:92%;"></div>
                <div class="mini-headline" style="width:60%;"></div>
                <div class="mini-sub"></div>
                <div class="mini-btn" style="width:60px; margin-bottom:14px;">
                </div>
                <div class="mini-grid">
                  <div class="mini-card"></div><div class="mini-card"></div>
                </div>
              </div>
            </div>
            <div class="home-dot"></div>
          </div>
          <div class="device-label">Tablet</div>
        </div>

        <div class="device phone">
          <div class="device-shell">
            <div class="notch"></div>
            <div class="screen">
              <div class="mini-scope">
                <div class="mini-nav-row">
                  <div class="mini-logo"></div>
                  <div class="mini-line" style="width:12px;"></div>
                </div>
                <div class="mini-headline" style="width:95%;"></div>
                <div class="mini-headline" style="width:70%;"></div>
                <div class="mini-sub"></div>
                <div class="mini-btn" style="width:52px; margin-bottom:12px;">
                </div>
                <div class="mini-grid">
                  <div class="mini-card"></div>
                </div>
              </div>
            </div>
            <div class="home-indicator"></div>
          </div>
          <div class="device-label">Mobile</div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPONENT: GetStarted (id="iniziare") -->
  <section id="iniziare" class="py-24">
    <div class="max-w-[1180px] mx-auto px-7">
      <div class="max-w-[680px] mb-13">
        <span
          class="block sb-eyebrow text-sb-primary mb-3.5"
          >// tre modi per iniziare</span
        >
        <h2>Come usare questo template</h2>
        <p
          class="mt-3.5 text-[15.5px]"
        >
          Scegli il metodo che preferisci: interfaccia GitHub, GitHub CLI o
          Astro CLI — portano tutti allo stesso risultato.
        </p>
      </div>

      <div class="grid grid-cols-1 min-[940px]:grid-cols-3 gap-6">
        <div class="flex flex-col gap-4">
          <div class="flex items-baseline gap-3">
            <span class="sb-num-display"
              >01</span
            >
            <h4>Dal browser</h4>
          </div>
          <p class="text-[14px] leading-snug">
            Usa il pulsante "Use this template" sulla repo per creare una nuova
            repository con l'intera struttura già pronta da clonare.
          </p>
          <div
            class="border border-dashed border-sb-border rounded-sb-lg px-4.5 py-5 font-sb-mono text-[12.5px] text-sb-muted-foreground flex items-center gap-2.5"
          >
            <span>Use this template ▾</span>
          </div>
          <a
            href="https://docs.github.com/en/repositories/creating-and-managing-repositories/creating-a-repository-from-a-template"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-[13px] font-bold text-sb-primary hover:underline"
            >Guida GitHub ↗</a
          >
        </div>

        <div class="flex flex-col gap-4">
          <div class="flex items-baseline gap-3">
            <span class="sb-num-display"
              >02</span
            >
            <h4>Da GitHub CLI</h4>
          </div>
          <p class="text-[14px] leading-snug">
            Crea direttamente da terminale una nuova repository a partire dal
            template.
          </p>
          <div class="terminal !text-[11.5px]">
            <div class="term-bar">
              <span class="term-dot"></span><span class="term-dot"></span><span
                class="term-dot"></span>
            </div>
            <div class="term-body !py-4 !px-4 !text-[11.8px]">
              <div>
                <span class="prompt">$</span>
                <span class="cmd">gh repo create my-project \</span>
              </div>
              <div>
                <span class="cmd"
                  >&nbsp;&nbsp;--template stefanBid/sb-template-astro</span
                >
              </div>
            </div>
          </div>
          <a
            href="https://cli.github.com/manual/gh_repo_create"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-[13px] font-bold text-sb-primary hover:underline"
            >gh repo create ↗</a
          >
        </div>

        <div class="flex flex-col gap-4">
          <div class="flex items-baseline gap-3">
            <span class="sb-num-display"
              >03</span
            >
            <h4>Da Astro CLI</h4>
          </div>
          <p class="text-[14px] leading-snug">
            Genera il progetto direttamente con lo strumento ufficiale di Astro.
          </p>
          <div class="terminal !text-[11.5px]">
            <div class="term-bar">
              <span class="term-dot"></span><span class="term-dot"></span><span
                class="term-dot"></span>
            </div>
            <div class="term-body !py-4 !px-4 !text-[11.8px]">
              <div>
                <span class="prompt">$</span>
                <span class="cmd">pnpm create astro@latest \</span>
              </div>
              <div>
                <span class="cmd"
                  >&nbsp;&nbsp;-- --template sb-template-astro</span
                >
              </div>
            </div>
          </div>
          <a
            href="https://docs.astro.build/en/install-and-setup/#use-a-theme-or-starter-template"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-[13px] font-bold text-sb-primary hover:underline"
            >Astro: usa un template ↗</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- COMPONENT: Requirements (id="requisiti") -->
  <section id="requisiti" class="py-24">
    <div class="max-w-[1180px] mx-auto px-7">
      <div class="max-w-[680px] mb-13">
        <span
          class="block sb-eyebrow text-sb-primary mb-3.5"
          >// prima di iniziare</span
        >
        <h2>Requisiti</h2>
        <p
          class="mt-3.5 text-[15.5px]"
        >
          Solo due strumenti da avere installati prima di generare il progetto.
        </p>
      </div>

      <div class="grid grid-cols-1 min-[700px]:grid-cols-2 gap-5">
        <div
          class="border border-sb-border rounded-sb-lg p-6.5 bg-sb-card flex gap-4.5 items-start"
        >
          <div
            class="w-10 h-10 rounded-sb-md bg-sb-secondary flex items-center justify-center font-sb-mono text-[13px] text-sb-primary shrink-0"
          >
            JS
          </div>
          <div>
            <h4 class="text-[16px] mb-1.5">Node.js</h4>
            <p class="text-[14px] leading-snug">
              Versione <code
                class="bg-sb-secondary px-1.5 py-0.5 rounded text-[13px]"
                >≥ 22.12.0</code
              >. È il runtime richiesto da Astro per dev server e build.
            </p>
          </div>
        </div>
        <div
          class="border border-sb-border rounded-sb-lg p-6.5 bg-sb-card flex gap-4.5 items-start"
        >
          <div
            class="w-10 h-10 rounded-sb-md bg-sb-secondary flex items-center justify-center font-sb-mono text-[13px] text-sb-primary shrink-0"
          >
            PN
          </div>
          <div>
            <h4 class="text-[16px] mb-1.5">pnpm</h4>
            <p class="text-[14px] leading-snug">
              Il package manager usato dal template, incluso il workspace già
              configurato per i permessi di build (<code
                class="bg-sb-secondary px-1.5 py-0.5 rounded text-[13px]"
                >esbuild</code
              >, <code
                class="bg-sb-secondary px-1.5 py-0.5 rounded text-[13px]"
                >sharp</code
              >).
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPONENT: ScriptsReference -->
  <section id="script" class="py-24">
    <div class="max-w-[1180px] mx-auto px-7">
      <div class="max-w-[680px] mb-13">
        <span
          class="block sb-eyebrow text-sb-primary mb-3.5"
          >// script disponibili</span
        >
        <h2>Come far partire il progetto</h2>
        <p
          class="mt-3.5 text-[15.5px]"
        >
          Ogni comando è già pronto in <code
            class="bg-sb-secondary px-1.5 py-0.5 rounded text-[0.9em]"
            >package.json</code
          >: basta lanciarlo con pnpm.
        </p>
      </div>

      <div class="terminal">
        <div class="term-bar">
          <span class="term-dot"></span><span class="term-dot"></span><span
            class="term-dot"></span>
          <span class="term-title">package.json — scripts</span>
        </div>
        <div class="term-body">
          <div>
            <span class="prompt">$</span>
            <span class="cmd">pnpm dev</span>
            <span class="cmt"
              >→ avvia il server di sviluppo su localhost:4321</span
            >
          </div>
          <div>
            <span class="prompt">$</span>
            <span class="cmd">pnpm build</span>
            <span class="cmt">→ crea la build di produzione in dist/</span>
          </div>
          <div>
            <span class="prompt">$</span>
            <span class="cmd">pnpm preview</span>
            <span class="cmt"
              >→ visualizza in locale la build di produzione</span
            >
          </div>
          <div>
            <span class="prompt">$</span>
            <span class="cmd">pnpm astro ...</span>
            <span class="cmt"
              >→ esegue comandi della Astro CLI, es. astro add</span
            >
          </div>
          <div>
            <span class="prompt">$</span>
            <span class="cmd">pnpm lint</span>
            <span class="cmt">→ controlla il codice con ESLint</span>
          </div>
          <div>
            <span class="prompt">$</span>
            <span class="cmd">pnpm lint:fix</span>
            <span class="cmt"
              >→ corregge automaticamente i problemi rilevabili</span
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPONENT: ProjectStructure (id="struttura") -->
  <section id="struttura" class="py-24">
    <div class="max-w-[1180px] mx-auto px-7">
      <div class="max-w-[680px] mb-13">
        <span
          class="block sb-eyebrow text-sb-primary mb-3.5"
          >// organizzazione</span
        >
        <h2>Struttura del progetto</h2>
        <p
          class="mt-3.5 text-[15.5px]"
        >
          File e cartelle principali, così sai subito dove mettere le mani.
        </p>
      </div>

      <div
        class="grid grid-cols-1 min-[940px]:grid-cols-[1.1fr_0.9fr] gap-10 items-start"
      >
        <div class="terminal">
          <div class="term-bar">
            <span class="term-dot"></span><span class="term-dot"></span><span
              class="term-dot"></span>
            <span class="term-title">tree -L 3</span>
          </div>
          <div class="term-body leading-[1.75]">
            <div>.</div>
            <div>├── .vscode</div>
            <div>├── public</div>
            <div>├── src</div>
            <div>│&nbsp;&nbsp;├── components</div>
            <div>│&nbsp;&nbsp;├── layouts</div>
            <div>│&nbsp;&nbsp;├── pages</div>
            <div>│&nbsp;&nbsp;└── styles</div>
            <div>│&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;├── global.css</div>
            <div>│&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;└── theme.css</div>
            <div>├── .gitignore</div>
            <div>├── AGENTS.md</div>
            <div>├── CLAUDE.md</div>
            <div>├── README.md</div>
            <div>├── astro.config.mjs</div>
            <div>├── eslint.config.mjs</div>
            <div>├── package.json</div>
            <div>├── pnpm-lock.yaml</div>
            <div>├── pnpm-workspace.yaml</div>
            <div>└── tsconfig.json</div>
          </div>
        </div>

        <div class="flex flex-col gap-5">
          <div>
            <div
              class="sb-label-mono-md"
            >
              src/components
            </div>
            <p class="text-[14px] leading-snug mt-1">
              Il set di componenti riutilizzabili per costruire le pagine.
            </p>
          </div>
          <div>
            <div
              class="sb-label-mono-md"
            >
              src/layouts
            </div>
            <p class="text-[14px] leading-snug mt-1">
              Gli involucri condivisi tra le pagine: struttura, head, elementi
              comuni.
            </p>
          </div>
          <div>
            <div
              class="sb-label-mono-md"
            >
              src/pages
            </div>
            <p class="text-[14px] leading-snug mt-1">
              Il routing file-based di Astro: ogni file qui è una rotta.
            </p>
          </div>
          <div>
            <div
              class="sb-label-mono-md"
            >
              src/styles
            </div>
            <p class="text-[14px] leading-snug mt-1">
              <code
                class="bg-sb-secondary px-1.5 py-0.5 rounded text-[0.9em]"
                >global.css</code
              > e <code
                class="bg-sb-secondary px-1.5 py-0.5 rounded text-[0.9em]"
                >theme.css</code
              >: qui personalizzi i colori e i token del design system.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPONENT: CreatorSection (id="creatore") -->
  <section id="creatore" class="pb-24">
    <div class="max-w-[1180px] mx-auto px-7">
      <div
        class="border border-sb-border rounded-3xl p-11 max-[860px]:p-8 grid grid-cols-1 min-[860px]:grid-cols-[1.3fr_1fr] gap-10 items-center"
      >
        <div>
          <h3 class="sb-h3-display">
            Un progetto in manutenzione costante
          </h3>
          <p
            class="mt-3.5 text-[15px] max-w-[52ch]"
          >
            Creato e mantenuto da Stefano Biddau. Il template continua a
            ricevere modifiche e aggiornamenti: metti una stella alla repo per
            restare sempre informato su ciò che cambia.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <a
            href="https://github.com/stefanBid/sb-template-astro"
            target="_blank"
            rel="noopener"
            class="flex items-center justify-between gap-3 border border-sb-border rounded-sb-lg px-4.5 py-3.5 text-[14px] font-bold hover:border-sb-primary"
          >
            <span>⭐ Stella la repo su GitHub</span><span
              class="text-sb-primary">↗</span
            >
          </a>
          <a
            href="https://github.com/stefanBid"
            target="_blank"
            rel="noopener"
