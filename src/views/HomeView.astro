---
import Layout from '@layouts/Layout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import ArticleCard from '@components/ArticleCard.astro';
import TechIcon from '@components/TechIcon.astro';
import CvDownload from '@components/CvDownload.astro';
import { projects } from '@data/projects';
import { skillCategories } from '@data/skills';
import { getCollection } from 'astro:content';
import { features } from '@data/site';
import { now } from '@data/now';
import type { Locale } from '@i18n/translations';
import { localePrefix } from '@i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const p = localePrefix(lang);

const text = {
  en: {
    title: 'Carmine Calabrese | Software Engineer & Security Enthusiast',
    description:
      "Personal portfolio of Carmine Calabrese. Master's in Computer Science, software engineering, IEEE research, backend, DevSecOps and game dev.",
    role: 'Software Engineer & Security Enthusiast',
    bio: [
      "Master's Degree candidate in Computer Science at the University of Salerno, co-author of a paper published at ",
      'IEEE SANER 2026',
      '. I combine software design, maintenance and project management with hands-on experience in security-oriented activities, and I am aiming at ',
      'Backend, DevOps and DevSecOps roles',
      '. Outside university I make games and open-source mods.',
    ],
    ctaProjects: 'View Projects',
    ctaContact: 'Get in Touch',
    skillsTitle: 'Core Technologies',
    skillsSubtitle: 'Languages, tools and environments I use the most',
    allSkills: 'All skills',
    projectsTitle: 'Featured Projects',
    projectsSubtitle: 'Research and university work first, then personal projects',
    allProjects: 'All projects',
    nowTitle: 'Now',
    articlesTitle: 'Latest Articles',
    articlesSubtitle: 'What I am learning along the way: pentesting, DevSecOps, software engineering',
    allArticles: 'All articles',
    noArticles: 'First articles coming soon. Stay tuned!',
  },
  it: {
    title: 'Carmine Calabrese | Software Engineer & Appassionato di Cybersecurity',
    description:
      'Portfolio personale di Carmine Calabrese. Laurea Magistrale in Informatica, software engineering, ricerca IEEE SANER, backend, DevSecOps e game dev.',
    role: 'Software Engineer & Appassionato di Cybersecurity',
    bio: [
      "Laureando Magistrale in Informatica all'Università degli Studi di Salerno, co-autore di un paper pubblicato a ",
      'IEEE SANER 2026',
      '. Unisco progettazione e manutenzione del software e project management a esperienza pratica in attività legate alla sicurezza, e punto a ',
      'ruoli Backend, DevOps e DevSecOps',
      '. Fuori dall’università sviluppo videogiochi e mod open-source.',
    ],
    ctaProjects: 'Guarda i Progetti',
    ctaContact: 'Contattami',
    skillsTitle: 'Tecnologie Principali',
    skillsSubtitle: 'Linguaggi, strumenti e ambienti che uso di più',
    allSkills: 'Tutte le competenze',
    projectsTitle: 'Progetti in Evidenza',
    projectsSubtitle: 'Prima ricerca e progetti universitari, poi quelli personali',
    allProjects: 'Tutti i progetti',
    nowTitle: 'Adesso',
    articlesTitle: 'Ultimi Articoli',
    articlesSubtitle: 'Quello che imparo lungo il percorso: pentesting, DevSecOps, software engineering',
    allArticles: 'Tutti gli articoli',
    noArticles: 'I primi articoli arriveranno presto. Resta sintonizzato!',
  },
}[lang];

const nameLines = ['Carmine', 'Calabrese'];

const coreSkills = skillCategories.flatMap((c) => c.items).filter((s) => s.core);
const featuredProjects = projects.filter((pr) => pr.featured).slice(0, 4);

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const latestArticles = allArticles
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<Layout lang={lang} title={text.title} description={text.description}>
  <!-- ================= HERO ================= -->
  <section class="pt-8 pb-14 sm:pt-16 sm:pb-20">
    <!-- Letters rise in on load (sb-letters); the label keeps the name readable as one word -->
    <h1 class="sb-display text-[3.4rem] sm:text-8xl" aria-label="Carmine Calabrese">
      {
        nameLines.map((word, w) => (
          <span class="sb-letters block" aria-hidden="true">
            {[...word].map((ch, i) => (
              <span style={`--i:${w * 7 + i}`}>{ch}</span>
            ))}
          </span>
        ))
      }
    </h1>

    <p class="font-sb-display text-xl sm:text-2xl text-sb-foreground mt-6">
      {text.role}
    </p>

    <p class="text-sm sm:text-base text-sb-muted-foreground mt-4 max-w-2xl leading-relaxed">
      {text.bio[0]}<span class="text-sb-foreground">{text.bio[1]}</span>{text.bio[2]}<span class="text-sb-foreground">{text.bio[3]}</span>{text.bio[4]}
    </p>

    <div class="flex flex-wrap items-center gap-3 mt-8">
      <CvDownload lang={lang} />

      <a
        href={`${p}/projects/`}
        class="px-4 py-2.5 rounded-sb-md border border-sb-border text-sb-foreground text-sm hover:border-sb-border-strong hover:bg-sb-card transition-colors"
      >
        {text.ctaProjects} &rarr;
      </a>

      <a
        href="https://github.com/Carmineh"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-sb-md text-sb-muted-foreground hover:text-sb-foreground text-sm transition-colors"
      >
        <TechIcon name="github" class="w-4 h-4" />
        GitHub
      </a>

      <a
        href="mailto:carmine.calabrese99@gmail.com"
        class="px-3.5 py-2.5 rounded-sb-md text-sb-muted-foreground hover:text-sb-foreground text-sm transition-colors"
      >
        {text.ctaContact}
      </a>
    </div>

  </section>

  <!-- ================= CORE SKILLS ================= -->
  <section class="py-12">
    <div class="flex items-end justify-between gap-4 mb-6">
      <div>
        <h2 class="sb-section-title"><span class="font-sb-mono text-sm text-sb-primary align-middle mr-2">01</span>{text.skillsTitle}</h2>
        <p class="text-sm text-sb-muted-foreground mt-1">{text.skillsSubtitle}</p>
      </div>
      <a href={`${p}/skills/`} class="shrink-0 text-xs font-sb-mono sb-link">
        {text.allSkills} &rarr;
      </a>
    </div>

    <!-- 4 columns: keep the number of core skills a multiple of 4 (or of 2) so rows stay full -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      {
        coreSkills.map((skill) => (
          <div class="sb-panel sb-panel-hover flex items-center gap-3 p-3">
            <div class="w-9 h-9 rounded-sb-md bg-sb-muted border border-sb-border flex items-center justify-center text-sb-primary shrink-0">
              <TechIcon name={skill.icon} class="w-[18px] h-[18px]" />
            </div>
            <span class="text-sm font-medium leading-tight text-sb-foreground">{skill.name}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ================= FEATURED PROJECTS ================= -->
  <section class="py-12">
    <div class="flex items-end justify-between gap-4 mb-6">
      <div>
        <h2 class="sb-section-title"><span class="font-sb-mono text-sm text-sb-primary align-middle mr-2">02</span>{text.projectsTitle}</h2>
        <p class="text-sm text-sb-muted-foreground mt-1">{text.projectsSubtitle}</p>
      </div>
      <a href={`${p}/projects/`} class="shrink-0 text-xs font-sb-mono sb-link">
        {text.allProjects} ({projects.length}) &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {featuredProjects.map((project) => <ProjectCard project={project} lang={lang} />)}
    </div>
  </section>

  <!-- ================= NOW ================= -->
  <section class="py-12">
    <h2 class="sb-section-title mb-6"><span class="font-sb-mono text-sm text-sb-primary align-middle mr-2">03</span>{text.nowTitle}</h2>

    <p class="max-w-3xl font-sb-display text-xl sm:text-3xl font-medium leading-snug tracking-tight text-sb-muted-foreground">
      {
        now.sentence[lang].map((part) =>
          part.tone === 'accent' ? (
            <span class="text-sb-primary">{part.text}</span>
          ) : part.tone === 'strong' ? (
            <span class="text-sb-foreground">{part.text}</span>
          ) : (
            part.text
          )
        )
      }
    </p>

    <p class="mt-5 text-xs font-sb-mono text-sb-muted-foreground">{now.updated[lang]}</p>
  </section>

  <!-- ================= ARTICLES ================= -->
  {features.articles && (
  <section class="py-12">
    <div class="flex items-end justify-between gap-4 mb-6">
      <div>
        <h2 class="sb-section-title"><span class="font-sb-mono text-sm text-sb-primary align-middle mr-2">04</span>{text.articlesTitle}</h2>
        <p class="text-sm text-sb-muted-foreground mt-1">{text.articlesSubtitle}</p>
      </div>
      {latestArticles.length > 0 && (
        <a href={`${p}/articles/`} class="shrink-0 text-xs font-sb-mono sb-link">
          {text.allArticles} ({allArticles.length}) &rarr;
        </a>
      )}
    </div>

    {
      latestArticles.length > 0 ? (
        <div class="grid grid-cols-1 gap-3.5">
          {latestArticles.map((article) => <ArticleCard article={article} lang={lang} />)}
        </div>
      ) : (
        <div class="sb-panel p-8 text-center">
          <p class="font-sb-mono text-sm text-sb-primary">$ ls ./articles</p>
          <p class="text-sm text-sb-muted-foreground mt-2">{text.noArticles}</p>
        </div>
      )
    }
  </section>
  )}
</Layout>
