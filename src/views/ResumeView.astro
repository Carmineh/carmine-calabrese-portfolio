      { category: 'Software Engineering', items: 'Software Maintenance & Evolution · TDD · Mutation Testing · Scrum' },
      { category: 'Cybersecurity & Pentesting', items: 'Penetration Testing · Vulnerability Assessment · Kali Linux · Nmap · Nessus · OWASP ZAP · WPScan · LinPEAS' },
      { category: 'Web & Databases', items: 'HTML · CSS · React · MySQL · PostgreSQL · PostGIS · MongoDB' },
      { category: 'Tools, DevOps & Blockchain', items: 'Git · GitHub · Docker · GitHub Actions · CI/CD · Blockchain · Zero-Knowledge Proofs' },
    ],
