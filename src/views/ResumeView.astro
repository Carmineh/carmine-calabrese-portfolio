    ],
    languages: [
      { name: 'Italiano', level: 'Madrelingua' },
      { name: 'Inglese', level: 'B2 (Intermedio superiore)' },
    ],
    hobbies: [
      {
        title: 'Gaming e sviluppo di videogiochi',
        description:
          'Appassionato di videogiochi, con esperienze personali nello sviluppo di giochi e nella realizzazione di progetti open source in questo ambito.',
      },
      {
        title: 'Tecnologia e innovazione',
        description:
          "Interesse per l'esplorazione di nuove tecnologie e per l'apprendimento autonomo di strumenti al di fuori del percorso universitario.",
      },
    ],
    hobbyProjects: 'Progetti nati da queste passioni',
  },
}[lang];

// Personal projects are shown only under "Hobbies & Interests", not among university work
const hobbyProjects = projects.filter((pr) => pr.category === 'personal');
---

<Layout lang={lang} title={text.title} description={text.description}>
  <div class="space-y-12">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 pb-8 border-b border-sb-border">
      <div>
        <h1 class="sb-display text-5xl sm:text-7xl">{profile.name}<span class="sb-dot">.</span></h1>
        <p class="font-sb-display text-lg text-sb-foreground mt-3">{text.role}</p>
        <p class="text-xs text-sb-muted-foreground mt-3 flex flex-wrap gap-x-2 gap-y-1">
          <span>{text.location}</span>
          <span>•</span>
          <a href={`mailto:${profile.email}`} class="hover:text-sb-foreground transition-colors">{profile.email}</a>
          <span>•</span>
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-sb-foreground transition-colors">LinkedIn</a>
          <span>•</span>
          <a href={profile.github} target="_blank" rel="noopener noreferrer" class="hover:text-sb-foreground transition-colors">GitHub</a>
        </p>
      </div>
      <CvDownload lang={lang} label={it ? 'Scarica PDF' : 'Download PDF'} />
    </div>

    <!-- Summary -->
    <section>
      <h2 class="resume-heading"><span>01.</span> {text.sections[0]}</h2>
      <p class="text-sm text-sb-muted-foreground leading-relaxed max-w-3xl">{text.summary}</p>
    </section>

    <!-- Education -->
    <section>
      <h2 class="resume-heading"><span>02.</span> {text.sections[1]}</h2>
      <div class="space-y-4">
        {
          text.education.map((edu) => (
            <div class="sb-panel p-5">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1">
                <h3 class="text-sm sm:text-base font-semibold text-sb-foreground">{edu.degree}</h3>
                <span class="shrink-0 text-xs font-sb-mono text-sb-muted-foreground">{edu.period}</span>
              </div>
              <p class="text-xs text-sb-muted-foreground font-sb-mono mt-1">{edu.institution}</p>
              {edu.grade && <p class="text-xs text-sb-foreground font-medium mt-1.5">{edu.grade}</p>}
              <p class="text-xs text-sb-muted-foreground mt-2 leading-relaxed">
                <span class="text-sb-muted-foreground font-sb-mono">{text.coursework}:</span> {edu.coursework}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- University projects -->
    <section>
      <h2 class="resume-heading"><span>03.</span> {text.sections[2]}</h2>
      <div class="space-y-6">
        {
          text.projects.map((pr) => (
            <div class="sb-timeline-item">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1.5">
                <h3 class="text-sm sm:text-base font-semibold text-sb-foreground">{pr.title}</h3>
                <span class="sb-chip-accent self-start sm:self-auto shrink-0">
                  {pr.badge}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-sb-muted-foreground leading-relaxed mt-1.5">{pr.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Skills -->
    <section>
      <h2 class="resume-heading"><span>04.</span> {text.sections[3]}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {
          text.skills.map((s) => (
            <div class="sb-panel p-4">
              <h3 class="sb-eyebrow mb-2">{s.category}</h3>
              <p class="text-xs text-sb-muted-foreground leading-relaxed">{s.items}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Languages -->
    <section>
      <h2 class="resume-heading"><span>05.</span> {text.sections[4]}</h2>
      <div class="flex flex-wrap gap-3">
        {
          text.languages.map((l) => (
            <div class="sb-panel px-4 py-3 text-xs">
              <span class="font-semibold text-sb-foreground">{l.name}:</span> <span class="text-sb-muted-foreground">{l.level}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Hobbies & interests, with the personal projects they led to -->
    <section>
      <h2 class="resume-heading"><span>06.</span> {text.sections[5]}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {
          text.hobbies.map((h) => (
            <div class="sb-panel p-4">
              <h3 class="text-sm font-semibold text-sb-foreground">{h.title}</h3>
              <p class="text-xs text-sb-muted-foreground mt-1.5 leading-relaxed">{h.description}</p>
            </div>
          ))
        }
      </div>

      <h3 class="sb-eyebrow mt-8 mb-4">{text.hobbyProjects}</h3>
      <div class="space-y-6">
        {
          hobbyProjects.map((pr) => {
            const href = pr.liveUrl || pr.repoUrl;
            return (
              <div class="sb-timeline-item">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1.5">
                  <h3 class="text-sm sm:text-base font-semibold text-sb-foreground">
                    {href ? (
                      <a href={href} target="_blank" rel="noopener noreferrer" class="hover:underline decoration-sb-primary underline-offset-4">
                        {pr.title} <span class="text-sb-muted-foreground">&nearr;</span>
                      </a>
                    ) : (
                      pr.title
                    )}
                  </h3>
                  {pr.highlight && <span class="sb-chip-accent self-start sm:self-auto shrink-0">{pr.highlight}</span>}
                </div>
                <p class="text-xs sm:text-sm text-sb-muted-foreground leading-relaxed mt-1.5">{it ? pr.descriptionIt : pr.descriptionEn}</p>
              </div>
            );
          })
        }
      </div>
    </section>
  </div>
</Layout>

<style>
  @reference "../styles/global.css";

  .resume-heading {
    @apply flex items-baseline gap-3 font-sb-display text-xl font-medium text-sb-foreground mb-5 pb-3 border-b border-sb-border;
  }
  .resume-heading span {
    @apply font-sb-mono text-sm text-sb-primary;
  }
</style>
