---
import Layout from '@layouts/Layout.astro';
import CvDownload from '@components/CvDownload.astro';
import { projects } from '@data/projects';
import type { Locale } from '@i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const it = lang === 'it';

const profile = {
